# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon pooled connection string (https://neon.tech → project → Connection Details)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js session secret. Generate with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# Canonical origin of the deployment. Optional locally; set it in production so
# Auth.js builds callback URLs from this instead of the incoming Host header.
# AUTH_URL="https://your-app.vercel.app"
